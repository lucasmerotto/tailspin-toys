---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import type { Category, Publisher } from '../types/game';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoriesById = new Map<number, Category>();
const publishersById = new Map<number, Publisher>();

for (const game of games) {
  if (game.category) categoriesById.set(game.category.id, game.category);
  if (game.publisher) publishersById.set(game.publisher.id, game.publisher);
}

const categories = Array.from(categoriesById.values()).sort((a, b) => a.name.localeCompare(b.name));
const publishers = Array.from(publishersById.values()).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section aria-labelledby="featured-games-heading">
      <h2 id="featured-games-heading" class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-6 rounded-xl border border-slate-700 bg-slate-800/60 p-5 sm:grid-cols-[1fr_auto] sm:items-end"
            data-testid="game-filters"
          >
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-200">Filter by category</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label
                    for={`category-filter-${category.id}`}
                    class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500"
                  >
                    <input
                      id={`category-filter-${category.id}`}
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid="category-filter"
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex flex-wrap items-end gap-3">
              <div class="min-w-48">
                <label for="publisher-filter" class="mb-2 block text-sm font-semibold text-slate-200">
                  Filter by publisher
                </label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
              <button
                type="reset"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p class="mb-4 text-sm text-slate-300" role="status" aria-live="polite" aria-atomic="true" data-testid="filter-results">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}.
          </p>

          <div
            id="games-grid"
            class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </section>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  if (filterForm) {
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const resultsStatus = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('[data-testid="category-filter"]'));
    const publisherSelect = filterForm.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');

    if (!resultsStatus || !publisherSelect) {
      throw new Error('The game filters are missing required controls.');
    }

    filterForm.addEventListener('submit', (event) => event.preventDefault());

    /** Applies the current category and publisher selections to the rendered game cards. */
    const updateResults = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherSelect.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const matchesCategory =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const matchesPublisher =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      }

      resultsStatus.textContent = visibleCount === 0
        ? 'No games match those filters.'
        : `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}.`;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => requestAnimationFrame(updateResults));
  }
</script>
